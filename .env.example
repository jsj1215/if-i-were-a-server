# 이 파일을 .env 로 복사한 뒤 값을 채워서 사용한다. (.env 는 git 에 올라가지 않는다)
#   cp .env.example .env

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=commerce
MYSQL_USER=app
MYSQL_PASSWORD=

REDIS_PASSWORD=

# 앱 실행 시 접속 대상 (기본값: localhost)
# MYSQL_HOST=localhost
# REDIS_HOST=localhost
# KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Grafana 관리자 비밀번호 (http://localhost:3000, 아이디 admin)
GRAFANA_ADMIN_PASSWORD=

# Linux 에서 Prometheus 컨테이너가 앱 지표를 수집하려면 0.0.0.0 으로 설정 (기본값: 127.0.0.1)
# MANAGEMENT_ADDRESS=127.0.0.1
